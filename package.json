    "base45": "^2.0.1",
    "eslint-plugin-react": "^7.37.5",
    "modern-normalize": "^3.0.1",
    "next": "^16.4.2",
    "qr-scanner": "^1.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-image-crop": "^11.1.2",
    "react-redux": "^9.3.0",
    "react-toastify": "^11.1.0",
